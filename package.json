    "fast-xml-parser": "^4.5.3",
    "i18next": "^24.2.2",
    "lucide-react": "^0.474.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor-community/text-to-speech": "^6.0.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
